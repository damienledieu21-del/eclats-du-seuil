{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/zone.schema.json",
  "title": "Éclats du Seuil — zone du monde",
  "description": "Sous-lot 12.4. Documentation et aide à la saisie. La validation qui fait foi est celle du programme (ZoneValidator), avec le scénario de zone et le catalogue des objets. Schéma 3 (Vallons agrandis, 28 octobre 2026) : routes et chemins facultatifs (roads), affichage seulement. Schéma 4 (intérieurs, 28 octobre 2026) : intérieur facultatif (indoor) et portes facultatives (doors) vers d'autres zones, qui se répondent. Schéma 5 (sous-lot V1.6) : autres chefs à formes facultatifs (chiefs, même forme que boss) et famille facultative d'une population (family, objectifs defeatFamily). Schéma 6 (réponses de Damien du 31 octobre 2026) : créature rare de la nuit facultative sur une population (night : chancePercent, signMs, sign).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 7
    },
    "kind": {
      "const": "zone"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scenario",
        "entry",
        "safePoints",
        "places",
        "populations",
        "passages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^zone\\.[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$",
          "description": "Scénario de zone sous scenarios/, sans extension (zone: true, bloc space).",
          "maxLength": 200
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "safePoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "places": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "min",
              "max"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "min": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "max": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "minLevel": {
                "type": "integer",
                "minimum": 1,
                "description": "Sous-lot V1.8 (schéma 7, zones en mélange) : niveau minimum du lieu (1 par défaut) ; ses créatures ne descendent jamais en dessous."
              }
            }
          }
        },
        "populations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "creature",
              "respawnMs",
              "leashRange"
            ],
            "properties": {
              "creature": {
                "type": "string",
                "description": "Assaillant mortel et placé du scénario ; ses vies suivantes : <créature>_v2, _v3…",
                "minLength": 1,
                "maxLength": 60,
                "not": {
                  "pattern": "_v[0-9]+$"
                }
              },
              "respawnMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 3600000
              },
              "leashRange": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100,
                "description": "Écart à sa cible (entre les bords) au-delà duquel la créature lâche, en mètres."
              },
              "loot": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^loot(\\.[a-z0-9_]+)+$",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "family": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64,
                "description": "Sous-lot V1.6 : famille (objectifs defeatFamily) ; absente : la créature sans ses chiffres finaux."
              },
              "night": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chancePercent",
                  "signMs",
                  "sign"
                ],
                "description": "Schéma 6 : créature rare de la nuit, absente au début d'une session ; une chance d'apparaître chaque nuit du monde (de 22 h à 5 h, tirage par la clé de la nuit), après un signe ; toujours là, après le signe, quand une quête ou un contrat en cours la demande.",
                "properties": {
                  "chancePercent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "signMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600000,
                    "description": "Délai entre le signe et l'arrivée, multiple du tick."
                  },
                  "sign": {
                    "type": "string",
                    "pattern": "^text(\\.[a-z0-9_]+)+$",
                    "maxLength": 200,
                    "description": "Clé du texte du signe."
                  }
                }
              }
            }
          }
        },
        "scaling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseLevel",
            "bossBaseLevel",
            "healthPerLevelPercent",
            "damagePerLevelPercent",
            "easeLevels"
          ],
          "properties": {
            "baseLevel": {
              "type": "integer",
              "minimum": 1,
              "description": "Niveau pour lequel les chiffres des créatures du scénario sont écrits."
            },
            "bossBaseLevel": {
              "type": "integer",
              "minimum": 1,
              "description": "Niveau pour lequel les chiffres des formes des chefs sont écrits."
            },
            "healthPerLevelPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "PV en plus par niveau, en pour cent des PV écrits."
            },
            "damagePerLevelPercent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Dégâts bruts en plus par niveau, en pour cent."
            },
            "easeLevels": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "description": "Les créatures montent au niveau du joueur moins ces niveaux (jamais sous le niveau minimum du lieu)."
            }
          },
          "description": "Sous-lot V1.8 (schéma 7, sujet 4) : zones en mélange ; facultatif. Niveau d'une créature : max(niveau minimum de son lieu, niveau du joueur − easeLevels)."
        },
        "passages": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "obstacle"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "obstacle": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "boss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scenario",
            "forms",
            "fact",
            "rewards"
          ],
          "description": "Sous-lot 12.7 (schéma 2) : chef à formes successives ; première victoire récompensée une seule fois.",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 64
            },
            "scenario": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$",
              "maxLength": 200
            },
            "forms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 60,
                "not": {
                  "pattern": "_v[0-9]+$"
                }
              },
              "uniqueItems": true
            },
            "fact": {
              "type": "string",
              "pattern": "^fact(\\.[a-z0-9_]+)+$",
              "maxLength": 200
            },
            "rewards": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "item",
                  "count"
                ],
                "properties": {
                  "item": {
                    "type": "string",
                    "pattern": "^item(\\.[a-z0-9_]+)+$",
                    "maxLength": 200
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999
                  }
                }
              }
            },
            "loot": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^loot(\\.[a-z0-9_]+)+$",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "chiefs": {
          "type": "array",
          "maxItems": 4,
          "description": "Sous-lot V1.6 : autres chefs à formes (le chef des bandits).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scenario",
              "forms",
              "fact",
              "rewards"
            ],
            "description": "Sous-lot 12.7 (schéma 2) : chef à formes successives ; première victoire récompensée une seule fois.",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "scenario": {
                "type": "string",
                "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$",
                "maxLength": 200
              },
              "forms": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 60,
                  "not": {
                    "pattern": "_v[0-9]+$"
                  }
                },
                "uniqueItems": true
              },
              "fact": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$",
                "maxLength": 200
              },
              "rewards": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "item",
                    "count"
                  ],
                  "properties": {
                    "item": {
                      "type": "string",
                      "pattern": "^item(\\.[a-z0-9_]+)+$",
                      "maxLength": 200
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 999
                    }
                  }
                }
              },
              "loot": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^loot(\\.[a-z0-9_]+)+$",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "roads": {
          "type": "array",
          "maxItems": 32,
          "description": "Vallons agrandis (schéma 3) : routes et chemins de la zone, lignes brisées de largeur constante dans l'aire praticable. Affichage seulement : le moteur ne les connaît pas.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "width",
              "points"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "kind": {
                "enum": [
                  "terre",
                  "pave"
                ],
                "description": "terre : chemin de terre battue ; pave : rue pavée."
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 20,
                "description": "Largeur en mètres."
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "maxItems": 32,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "indoor": {
          "type": "boolean",
          "description": "La zone est un intérieur (une pièce : l'aire en est le sol, ses bords les murs). Affichage seulement."
        },
        "doors": {
          "type": "array",
          "maxItems": 16,
          "description": "Portes vers d'autres zones : on s'y tient pour passer, on y arrive en venant de la porte toDoor de la zone to, qui ramène ici.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position",
              "to",
              "toDoor"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Ce qu'il y a derrière (« Auberge de l'Aube »)."
              },
              "position": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "to": {
                "type": "string",
                "pattern": "^zone\\.[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "toDoor": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "building": {
                "type": "string",
                "description": "Obstacle du scénario (le bâtiment) dont c'est la porte, à 2 m au plus ; sa façade est tournée vers elle.",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        }
      }
    }
  }
}
