{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/caravans.schema.json",
  "title": "Éclats du Seuil — caravanes et attaques des bandits",
  "description": "Caravanes (sous-lot V2.41.1), version 2 (sous-lot V2.41.3 : quête de reprise au fort, recovery ; la version 1, sans elle, est encore lue) : caravanes de marchands sur les routes de la zone (départ, fréquence, vitesse, route) et l'attaque des bandits qui les arrête à leur halte. Documentation. La validation qui fait foi est celle du programme (CaravanValidator), avec la zone et le catalogue d'objets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "caravans"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caravans"
      ],
      "properties": {
        "caravans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "start",
              "everyDays",
              "firstDay",
              "metersPerMinute",
              "wagons",
              "guards",
              "route",
              "attack"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 40
              },
              "start": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "everyDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "description": "Jours de caravane : d >= firstDay et d % everyDays == 0."
              },
              "firstDay": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "metersPerMinute": {
                "type": "number",
                "minimum": 1,
                "maximum": 120
              },
              "wagons": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "guards": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "route": {
                "type": "array",
                "minItems": 2,
                "maxItems": 64,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "recovery": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "place",
                  "days",
                  "guardRadius",
                  "chests",
                  "xp",
                  "money"
                ],
                "description": "Sous-lot V2.41.3 (version 2) : quête de reprise au fort après un pillage : lieu des coffres, jours d'ouverture à partir du jour du pillage, rayon où aucun ennemi ne doit être debout pour prendre un coffre, places des coffres (dans le lieu, à 3 m au moins l'un de l'autre), récompense quand tous sont repris (expérience, cuivre). Chaque coffre repris enlève un jour au contrecoup des marchands.",
                "properties": {
                  "place": {
                    "type": "string"
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "guardRadius": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "chests": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "xp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "money": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              },
              "attack": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "chancePercent",
                  "announceMinutes",
                  "durationMinutes",
                  "guardsPercent",
                  "groups",
                  "reward"
                ],
                "description": "Attaque des bandits : un événement du monde (voir zones), sans sorte, fenêtre ni heure (celles de la caravane : départ à l'heure où elle atteint sa halte, sans écart).",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 64
                  },
                  "chancePercent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "announceMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 720
                  },
                  "durationMinutes": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 720
                  },
                  "aftermathMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4320
                  },
                  "weather": {
                    "type": "object"
                  },
                  "place": {
                    "type": "string"
                  },
                  "guardsPercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Chance que les gardes repoussent seuls les bandits quand le joueur ne sauve pas la caravane."
                  },
                  "minLevel": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "groups": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "weight",
                        "position",
                        "creatures"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "weight": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "position": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          },
                          "description": "Halte de la caravane : un point de sa route, ni le premier ni le dernier, le même pour toutes les variantes."
                        },
                        "creatures": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 8,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "like",
                              "position"
                            ],
                            "properties": {
                              "like": {
                                "type": "string"
                              },
                              "position": {
                                "type": "array",
                                "minItems": 2,
                                "maxItems": 2,
                                "items": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "reward": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "xp",
                      "money"
                    ],
                    "properties": {
                      "xp": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000
                      },
                      "money": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "items": {
                        "type": "array",
                        "maxItems": 4,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "item",
                            "count"
                          ],
                          "properties": {
                            "item": {
                              "type": "string"
                            },
                            "count": {
                              "type": "integer",
                              "minimum": 1
                            }
                          }
                        }
                      },
                      "fact": {
                        "type": "string"
                      },
                      "bounty": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000,
                        "description": "Prime en cuivre de chaque caravane sauvée après la première."
                      }
                    }
                  },
                  "lostFact": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
