{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/progression.schema.json",
  "title": "Éclats du Seuil — progression du personnage persistant",
  "description": "Sous-lot 12.2 (schéma 3 : sous-lot V1.8, plafond de niveau et chapitres). Documentation et aide à la saisie. La validation qui fait foi est celle du programme (ProgressionValidator, contre les règles et les classes).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "progression"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLevel",
        "levelCap",
        "chapterStartLevels",
        "xpToLevel",
        "killXpPerHealth",
        "classes"
      ],
      "properties": {
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "description": "Niveau le plus haut décrit par les données (sous-lot V1.8 : 30, valeurs provisoires au-delà du plafond), au plus progression.maxLevel des règles."
        },
        "levelCap": {
          "type": "integer",
          "minimum": 1,
          "description": "Sous-lot V1.8 (sujet 54) : plafond de niveau actuel (25 dans les Vallons, en alpha), au plus maxLevel ; il monte à chaque extension. L'expérience continue de s'accumuler au plafond."
        },
        "chapterStartLevels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Sous-lot V1.8 : premier niveau de chaque chapitre de la quête principale, strictement croissant, le premier au niveau 1, tous au plus levelCap (le dernier chapitre va jusqu'au plafond)."
        },
        "xpToLevel": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "description": "Expérience cumulée pour être à chaque niveau, du niveau 1 (0) au niveau maximal, strictement croissante."
        },
        "killXpPerHealth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000,
          "description": "Expérience d'une créature vaincue : 1 point par tranche de ces PV maximaux, au moins 1."
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "attributes",
              "startActiveSkills",
              "startPassiveSkills",
              "skillUnlocks"
            ],
            "properties": {
              "class": {
                "type": "string"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "force",
                    "dexterite",
                    "intelligence",
                    "vitalite",
                    "volonte",
                    "endurance"
                  ],
                  "properties": {
                    "force": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "dexterite": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "intelligence": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "vitalite": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "volonte": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "endurance": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    }
                  }
                },
                "description": "Attributs de base, du niveau 1 au niveau maximal (cadrage Q20), jamais en baisse."
              },
              "startActiveSkills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "startPassiveSkills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skillUnlocks": {
                "type": "array",
                "maxItems": 64,
                "description": "Sous-lot 12.9b (schéma 2) : compétences gagnées en montant de niveau, équipées d'elles-mêmes à la halte qui suit, dans l'ordre des niveaux. Chaque niveau doit garder un build valide (emplacements ouverts par les règles).",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "level",
                    "skill"
                  ],
                  "properties": {
                    "level": {
                      "type": "integer",
                      "minimum": 2
                    },
                    "skill": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
