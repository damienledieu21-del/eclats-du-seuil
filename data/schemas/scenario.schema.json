{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/scenario.schema.json",
  "title": "Éclats du Seuil — scénario de combat simulé",
  "description": "Documentation et aide à la saisie. La validation qui fait foi est celle du programme (ScenarioValidator et CombatSetup.Validate).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 4
    },
    "kind": {
      "const": "scenario"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "durationMs",
        "combatants",
        "commands"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Graine PCG32 du combat."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Durée simulée, multiple du tick, au plus combat.limits.maxDurationMs."
        },
        "combatants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/combatant"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "combatant": {
      "type": "object",
      "required": [
        "id",
        "type",
        "team",
        "initiative"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "enum": [
            "character",
            "dummy",
            "assailant"
          ]
        },
        "team": {
          "$ref": "#/$defs/name"
        },
        "initiative": {
          "type": "integer",
          "description": "Commandes simultanées : la plus grande initiative agit d'abord, puis l'identifiant."
        },
        "class": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "armor": {
          "type": "number",
          "minimum": 0
        },
        "magicResistance": {
          "type": "number",
          "minimum": 0
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000,
          "description": "Assaillant (schéma 4, sous-lot 11.1) : PV d'un assaillant mortel, qui meurt à 0 ; absent : PV infinis (entraînement)."
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ],
          "description": "Assaillant : cible de ses attaques à cible unique ; null si toutes ses attaques sont de zone."
        },
        "firstAttackMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Assaillant : instant de la première attaque, multiple du tick."
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Assaillant : intervalle entre deux attaques (A21 : 2000)."
        },
        "attacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attack"
          },
          "description": "Assaillant : attaques jouées dans l'ordre, puis en boucle."
        },
        "statusResistance": {
          "type": "number",
          "description": "Mannequin et assaillant : résistance aux altérations (lot 7.2), facultative, 0 par défaut ; réduit la durée des contrôles."
        },
        "triggers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/trigger"
          },
          "description": "Déclencheurs (lot 7.3), au plus 8."
        }
      },
      "additionalProperties": false,
      "description": "character : class et build ; dummy : armor et magicResistance ; assailant : armor, magicResistance, target, firstAttackMs, intervalMs et attacks (health facultatif)."
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "attributes",
        "talents",
        "activeSkills",
        "passiveSkills"
      ],
      "properties": {
        "level": {
          "type": "integer"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "force",
            "dexterite",
            "intelligence",
            "vitalite",
            "volonte",
            "endurance"
          ],
          "properties": {
            "force": {
              "type": "integer",
              "minimum": 0
            },
            "dexterite": {
              "type": "integer",
              "minimum": 0
            },
            "intelligence": {
              "type": "integer",
              "minimum": 0
            },
            "vitalite": {
              "type": "integer",
              "minimum": 0
            },
            "volonte": {
              "type": "integer",
              "minimum": 0
            },
            "endurance": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "talents": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "activeSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ultimate": {
          "type": [
            "string",
            "null"
          ]
        },
        "passiveSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atMs",
        "actor"
      ],
      "description": "Compétence (skill, target) ou action défensive (action), jamais les deux.",
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Instant de la commande, multiple du tick."
        },
        "actor": {
          "$ref": "#/$defs/name"
        },
        "skill": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "Absente ou null pour une compétence de zone."
        },
        "action": {
          "enum": [
            "guardStart",
            "guardStop",
            "parry"
          ],
          "description": "Garde (A1) ou parade parfaite (A2)."
        }
      },
      "oneOf": [
        {
          "required": [
            "skill"
          ],
          "not": {
            "required": [
              "action"
            ]
          }
        },
        {
          "required": [
            "action"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "skill"
                ]
              },
              {
                "required": [
                  "target"
                ]
              }
            ]
          }
        }
      ]
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rawDamage",
        "damageType",
        "targeting",
        "unblockable",
        "applies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "rawDamage": {
          "type": "integer",
          "minimum": 0,
          "description": "Dégâts bruts avant armure ou résistance magique (A21 : 100)."
        },
        "damageType": {
          "enum": [
            "physique",
            "magique"
          ]
        },
        "targeting": {
          "enum": [
            "enemy",
            "allEnemies"
          ]
        },
        "unblockable": {
          "type": "boolean",
          "description": "Imparable : ignore garde et parade."
        },
        "applies": {
          "type": "array",
          "description": "Altérations appliquées à chaque cible touchée après l'impact (lot 7.2) ; éventuellement vide.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "description": "Identifiant d'une altération du bloc statuses de rules.json (ni immunité ni rupture de garde)."
              },
              "coefficient": {
                "type": "number",
                "description": "DOT seulement, obligatoire : coefficient de la puissance de la source par tick, [0, 100]."
              },
              "target": {
                "enum": [
                  "self",
                  "allAllies",
                  "allEnemies"
                ],
                "description": "Sous-lot 8.3 : cible propre de l'application, relative à l'acteur (lui-même, ses alliés vivants lui compris, ses ennemis vivants), appliquée une fois après les impacts ; absente : chaque cible de l'action."
              }
            }
          }
        }
      }
    },
    "rankedValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base": {
              "type": "number"
            },
            "perRank": {
              "type": "number",
              "description": "Talents seulement : ajouté à chaque rang au-delà du premier."
            }
          },
          "required": [
            "base"
          ]
        }
      ],
      "description": "Nombre décimal, ou valeur par rang { base, perRank } (talents seulement)."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "enum": [
            "onSkillCast",
            "onHitDealt",
            "onHitTaken",
            "onBlock",
            "onPerfectParry",
            "onGuardBroken",
            "onResourceGained",
            "onStateApplied",
            "onStateExpired",
            "onStateRemoved",
            "onDotTick",
            "onDeath"
          ],
          "description": "Type d'abonnement : l'événement de jeu observé (les diagnostics ne déclenchent jamais)."
        },
        "role": {
          "enum": [
            "self",
            "source",
            "target",
            "ally"
          ],
          "description": "Rôle du porteur dans l'événement ; facultatif quand le type n'en admet qu'un. ally (sous-lot 8.3) : la cible de l'événement est un allié vivant du porteur, autre que lui ; jamais implicite, admis là où target l'est."
        },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Compétences ou attaques d'assaillant."
            },
            "damageType": {
              "enum": [
                "physique",
                "magique"
              ]
            },
            "defense": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "guard",
                  "parry",
                  "unblockable",
                  "guardBroken"
                ]
              }
            },
            "status": {
              "type": "string"
            },
            "category": {
              "enum": [
                "dot",
                "control",
                "modifier",
                "immunity",
                "buff",
                "shield",
                "taunt",
                "protection"
              ]
            },
            "resource": {
              "enum": [
                "rampartCharges",
                "resonance"
              ]
            },
            "renewed": {
              "type": "boolean"
            }
          }
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000,
          "description": "Recharge interne : intervalle minimal entre deux réactions acceptées, multiple du tick."
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "strike",
                  "applyStatus",
                  "gainResource"
                ]
              },
              "target": {
                "enum": [
                  "eventSource",
                  "eventTarget",
                  "bearer",
                  "allEnemies"
                ]
              },
              "coefficient": {
                "$ref": "#/$defs/rankedValue"
              },
              "powerType": {
                "enum": [
                  "physique",
                  "agile",
                  "magique"
                ]
              },
              "damageType": {
                "enum": [
                  "physique",
                  "magique"
                ]
              },
              "unblockable": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "resource": {
                "enum": [
                  "rampartCharges",
                  "resonance",
                  "endurance"
                ]
              },
              "amount": {
                "$ref": "#/$defs/rankedValue"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "required": [
        "on",
        "effects"
      ],
      "description": "Déclencheur (lot 7.3) : 1 à 4 effets exécutés comme une seule réaction."
    }
  }
}
