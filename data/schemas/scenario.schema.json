{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/scenario.schema.json",
  "title": "Éclats du Seuil — scénario de combat simulé",
  "description": "Documentation et aide à la saisie. La validation qui fait foi est celle du programme (ScenarioValidator et CombatSetup.Validate).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 12
    },
    "kind": {
      "const": "scenario"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "durationMs",
        "combatants",
        "commands"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Graine PCG32 du combat."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Durée simulée, multiple du tick, au plus combat.limits.maxDurationMs (zone : au plus 86 400 000 ms, 24 h)."
        },
        "space": {
          "$ref": "#/$defs/space"
        },
        "zone": {
          "type": "boolean",
          "description": "Sous-lot 12.1 (schéma 10) : simulation d'une zone du monde (combat positionné, bloc space obligatoire) : elle ne s'arrête pas quand une équipe tombe, seulement au bout de sa durée (jusqu'à 86 400 000 ms, 24 h). Absent ou faux : combat fermé."
        },
        "combatants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/combatant"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -1000,
        "maximum": 1000
      },
      "description": "Sous-lot 11.4 : point [x, z] du sol, en mètres (x vers l'est, z vers le nord), dans ±1000 m (borne technique)."
    },
    "direction": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "description": "Sous-lot 11.4 : direction [x, z], composantes dans [−1, 1], non toutes deux nulles ; le moteur la normalise."
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds"
      ],
      "properties": {
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/point"
            },
            "max": {
              "$ref": "#/$defs/point"
            }
          },
          "description": "Aire praticable : coin sud-ouest (min) et nord-est (max) ; chaque combattant y garde toute son emprise."
        },
        "obstacles": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "points"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/name"
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "maxItems": 16,
                "items": {
                  "$ref": "#/$defs/point"
                },
                "description": "Sommets d'un polygone strictement convexe, dans un sens ou dans l'autre."
              },
              "low": {
                "type": "boolean",
                "description": "Sous-lot 11.9 (schéma 9) : obstacle bas (rivière, muret) : il arrête la marche et les charges, mais pas la vue. Faux par défaut."
              }
            }
          },
          "description": "Obstacles solides du décor (murs, rochers, troncs), facultatifs."
        }
      },
      "description": "Sous-lot 11.4 (schéma 5) : espace d'un combat positionné. Avec lui, chaque combattant a position et radius."
    },
    "combatant": {
      "type": "object",
      "required": [
        "id",
        "type",
        "team",
        "initiative"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "enum": [
            "character",
            "dummy",
            "assailant"
          ]
        },
        "team": {
          "$ref": "#/$defs/name"
        },
        "initiative": {
          "type": "integer",
          "description": "Commandes simultanées : la plus grande initiative agit d'abord, puis l'identifiant."
        },
        "class": {
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "gear": {
          "type": "object",
          "additionalProperties": false,
          "description": "Sous-lot 12.3 (schéma 11) : bonus de l'équipement porté par un personnage, ajoutés à ses statistiques ; champs absents à 0.",
          "properties": {
            "physicalPower": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "agilePower": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "magicPower": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "armor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "magicResistance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "maxHealth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "maxEndurance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "statusResistance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "armor": {
          "type": "number",
          "minimum": 0
        },
        "magicResistance": {
          "type": "number",
          "minimum": 0
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000,
          "description": "Assaillant (schéma 4, sous-lot 11.1) : PV d'un assaillant mortel, qui meurt à 0 ; absent : PV infinis (entraînement)."
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ],
          "description": "Assaillant : cible de ses attaques à cible unique ; null si toutes ses attaques sont de zone."
        },
        "firstAttackMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Assaillant : instant de la première attaque, multiple du tick."
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Assaillant : intervalle entre deux attaques (A21 : 2000)."
        },
        "attacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attack"
          },
          "description": "Assaillant : attaques jouées dans l'ordre, puis en boucle."
        },
        "statusResistance": {
          "type": "number",
          "description": "Mannequin et assaillant : résistance aux altérations (lot 7.2), facultative, 0 par défaut ; réduit la durée des contrôles."
        },
        "triggers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/trigger"
          },
          "description": "Déclencheurs (lot 7.3), au plus 8."
        },
        "position": {
          "$ref": "#/$defs/point",
          "description": "Combat positionné (bloc space) : centre de l'emprise au départ."
        },
        "facing": {
          "$ref": "#/$defs/direction",
          "description": "Combat positionné : orientation de départ, facultative ([0, 1], vers le nord, par défaut)."
        },
        "radius": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5,
          "description": "Combat positionné : rayon de l'emprise au sol, en mètres (Bastion 0,5 ; loup 0,6 ; chef 1,2)."
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20,
          "description": "Assaillant d'un combat positionné : vitesse de marche propre, en m/s ; facultative (combat.movement.speed sinon)."
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxRange"
          ],
          "properties": {
            "maxRange": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Distance maximale à garder avec sa cible, entre les bords (m) : au-delà, l'ennemi approche."
            },
            "minRange": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Distance minimale (m) : en deçà, il recule ; 0 par défaut."
            },
            "aggroRange": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100,
              "description": "Distance d'engagement (m) : il attend qu'un ennemi y entre (ou qu'on le frappe, ou qu'on le provoque) ; absente : engagé dès le départ."
            },
            "encircle": {
              "type": "boolean",
              "description": "Se répartir autour de la cible avec la meute qui la vise."
            },
            "pack": {
              "type": "boolean",
              "description": "Sous-lot 11.9 (schéma 9) : entraîné par l'engagement d'un allié à comportement à sa distance d'engagement (meute). Vrai par défaut ; faux : il ne s'engage que pour lui-même."
            }
          },
          "description": "Sous-lot 11.5 : comportement d'un assaillant d'un combat positionné (il se déplace seul : pas de move ni de stop pour lui ; cible : provocation, sinon sa target présente et vivante, sinon l'ennemi le plus proche)."
        },
        "arrivalMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Sous-lot 11.4d : arrivée en cours de combat, en millisecondes (multiple du tick, avant la fin) ; absente : présent dès le départ. Avant son arrivée, le combattant n'agit pas et n'est pas ciblé ; arrivée refusée si une emprise solide occupe sa place."
        },
        "consumables": {
          "type": "array",
          "maxItems": 16,
          "description": "Sous-lot 12.6 (schéma 12) : objets de soin emportés par un personnage ; leur recharge est partagée.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "heal",
              "charges",
              "cooldownMs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^item(\\.[a-z0-9_]+)+$"
              },
              "heal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "charges": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "cooldownMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "description": "character : class et build ; dummy : armor et magicResistance ; assailant : armor, magicResistance, target, firstAttackMs, intervalMs et attacks (health facultatif). Combat positionné (sous-lot 11.4) : position et radius, facing facultatif ; speed facultatif pour un assaillant."
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "attributes",
        "talents",
        "activeSkills",
        "passiveSkills"
      ],
      "properties": {
        "level": {
          "type": "integer"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "force",
            "dexterite",
            "intelligence",
            "vitalite",
            "volonte",
            "endurance"
          ],
          "properties": {
            "force": {
              "type": "integer",
              "minimum": 0
            },
            "dexterite": {
              "type": "integer",
              "minimum": 0
            },
            "intelligence": {
              "type": "integer",
              "minimum": 0
            },
            "vitalite": {
              "type": "integer",
              "minimum": 0
            },
            "volonte": {
              "type": "integer",
              "minimum": 0
            },
            "endurance": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "talents": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "activeSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ultimate": {
          "type": [
            "string",
            "null"
          ]
        },
        "passiveSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atMs",
        "actor"
      ],
      "description": "Compétence (skill, target) ou action nommée (action), jamais les deux ; une direction pour l'action move seulement.",
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Instant de la commande, multiple du tick."
        },
        "actor": {
          "$ref": "#/$defs/name"
        },
        "skill": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "Absente ou null pour une compétence de zone."
        },
        "action": {
          "enum": [
            "guardStart",
            "guardStop",
            "parry",
            "move",
            "stop",
            "select",
            "leave",
            "consume"
          ],
          "description": "Garde (A1), parade parfaite (A2), marche dans une direction ou arrêt (sous-lot 11.4, combat positionné) ; sélection d'une cible (select, sous-lot 11.4c, combat positionné : target facultatif, absent pour effacer ; en garde, le personnage se tourne vers sa cible) ; départ (leave, sous-lot 11.4d : effectif en fin de tick). Soin (consume, sous-lot 12.6) : utiliser l'objet de soin item emporté par le personnage."
        },
        "direction": {
          "$ref": "#/$defs/direction",
          "description": "Action move : direction de marche, jusqu'à un arrêt ou une autre direction."
        },
        "backward": {
          "type": "boolean",
          "description": "Sous-lot 11.9 (schéma 9) : action move à reculons, le combattant garde son orientation au lieu de se tourner vers sa marche (faux par défaut)."
        },
        "item": {
          "type": "string",
          "pattern": "^item(\\.[a-z0-9_]+)+$",
          "description": "Sous-lot 12.6 (schéma 12) : objet de soin d'une action consume, et d'elle seule."
        }
      },
      "oneOf": [
        {
          "required": [
            "skill"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "action"
                ]
              },
              {
                "required": [
                  "direction"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "action"
          ],
          "not": {
            "required": [
              "skill"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "move"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "direction"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "direction"
                  ]
                },
                {
                  "required": [
                    "backward"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "not": {
              "properties": {
                "action": {
                  "const": "select"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "target"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "consume"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "item"
            ]
          },
          "else": {
            "not": {
              "required": [
                "item"
              ]
            }
          }
        }
      ]
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rawDamage",
        "damageType",
        "targeting",
        "unblockable",
        "applies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "rawDamage": {
          "type": "integer",
          "minimum": 0,
          "description": "Dégâts bruts avant armure ou résistance magique (A21 : 100)."
        },
        "damageType": {
          "enum": [
            "physique",
            "magique"
          ]
        },
        "targeting": {
          "enum": [
            "enemy",
            "allEnemies"
          ]
        },
        "unblockable": {
          "type": "boolean",
          "description": "Imparable : ignore garde et parade."
        },
        "applies": {
          "type": "array",
          "description": "Altérations appliquées à chaque cible touchée après l'impact (lot 7.2) ; éventuellement vide.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "description": "Identifiant d'une altération du bloc statuses de rules.json (ni immunité ni rupture de garde)."
              },
              "coefficient": {
                "type": "number",
                "description": "DOT seulement, obligatoire : coefficient de la puissance de la source par tick, [0, 100]."
              },
              "target": {
                "enum": [
                  "self",
                  "allAllies",
                  "allEnemies"
                ],
                "description": "Sous-lot 8.3 : cible propre de l'application, relative à l'acteur (lui-même, ses alliés vivants lui compris, ses ennemis vivants), appliquée une fois après les impacts ; absente : chaque cible de l'action."
              }
            }
          }
        },
        "shape": {
          "enum": [
            "target",
            "cone",
            "circle",
            "line",
            "persistent"
          ],
          "description": "Sous-lot 11.4c, combat positionné, targeting enemy : coup dirigé (target), cône depuis l'assaillant (cone : range, angle), cercle autour de la cible ou de l'assaillant (circle : radius, center), bande (line : range, width), zone qui reste (persistent : radius, center, persistentMs, tickMs). Absente : attaque historique."
        },
        "telegraphMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Durée de l'annonce (ms, multiple du tick) : la forme est verrouillée au tour de l'assaillant et frappe au tick d'impact. Une zone doit laisser combat.telegraph.minReactionMs plus le temps d'en sortir au pas de base."
        },
        "range": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "description": "Coup dirigé : portée entre les bords des emprises (absente : sans limite) ; cône et bande : longueur depuis l'assaillant (obligatoire)."
        },
        "radius": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "description": "Cercle et zone persistante : rayon (obligatoire)."
        },
        "angle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180,
          "description": "Cône : ouverture en degrés (obligatoire)."
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "description": "Bande : largeur (obligatoire)."
        },
        "center": {
          "enum": [
            "target",
            "self"
          ],
          "description": "Cercle et zone persistante : centre, la cible (défaut) ou l'assaillant, au début de l'annonce."
        },
        "persistentMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Zone persistante : durée (ms, multiple du tick)."
        },
        "tickMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Zone persistante : cadence de ses impacts (ms, multiple du tick, au plus persistentMs)."
        },
        "guardable": {
          "type": "boolean",
          "description": "La garde réduit-elle les dégâts ? Défaut : oui pour un coup dirigé ou une attaque historique non imparable, non pour une zone ; jamais pour une zone persistante ni une attaque imparable."
        },
        "parryable": {
          "type": "boolean",
          "description": "La parade parfaite s'applique-t-elle ? Défaut : oui pour un coup dirigé ou une attaque historique non imparable ; jamais pour une zone ni une attaque imparable."
        },
        "charge": {
          "type": "boolean",
          "description": "Sous-lot 11.5 : charge (bande seulement) : à l'impact, après ses coups, l'ennemi fonce le long de l'axe jusqu'au bout, au premier obstacle ou à la première emprise solide."
        },
        "push": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "description": "Sous-lot 11.9 (schéma 9) : poussée (m, bande seulement) : à l'impact, après ses coups, chaque ennemi touché est repoussé le long de l'axe, arrêté par l'aire, le décor et les emprises solides ; une charge part ensuite."
        },
        "holdPosition": {
          "type": "boolean",
          "description": "Sous-lot 11.9 (schéma 9) : un ennemi à comportement s'arrête-t-il de marcher pendant l'annonce de cette attaque ? Vrai par défaut."
        }
      }
    },
    "rankedValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base": {
              "type": "number"
            },
            "perRank": {
              "type": "number",
              "description": "Talents seulement : ajouté à chaque rang au-delà du premier."
            }
          },
          "required": [
            "base"
          ]
        }
      ],
      "description": "Nombre décimal, ou valeur par rang { base, perRank } (talents seulement)."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "enum": [
            "onSkillCast",
            "onHitDealt",
            "onHitTaken",
            "onBlock",
            "onPerfectParry",
            "onGuardBroken",
            "onResourceGained",
            "onStateApplied",
            "onStateExpired",
            "onStateRemoved",
            "onDotTick",
            "onDeath"
          ],
          "description": "Type d'abonnement : l'événement de jeu observé (les diagnostics ne déclenchent jamais)."
        },
        "role": {
          "enum": [
            "self",
            "source",
            "target",
            "ally"
          ],
