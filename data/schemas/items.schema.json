{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/items.schema.json",
  "title": "Éclats du Seuil — catalogue des objets",
  "description": "Sous-lot 12.3, version 3 au sous-lot V1.2 (18 places, garde des boucliers, équipement de départ). Documentation et aide à la saisie. La validation qui fait foi est celle du programme (ItemValidator).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 4
    },
    "kind": {
      "const": "items"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots",
        "inventorySize",
        "starting",
        "items",
        "loot",
        "sets",
        "properties"
      ],
      "properties": {
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/slot"
          },
          "description": "Places d'équipement, dans l'ordre de l'écran (V1.2 : 18 places)."
        },
        "inventorySize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "Places de l'inventaire (tranche : 24)."
        },
        "starting": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item"
            ],
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^item(\\.[a-z0-9_]+)+$"
              },
              "class": {
                "type": "string",
                "description": "Classe qui le reçoit ; absente : toutes."
              }
            }
          },
          "description": "Équipement de départ, porté d'emblée par un nouveau personnage ; il remplit les places obligatoires."
        },
        "items": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "loot": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/lootTable"
          }
        },
        "sets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/set"
          },
          "description": "Sous-lot V1.3 (version 4) : ensembles."
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rarities",
            "list"
          ],
          "properties": {
            "rarities": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rarity",
                  "count",
                  "scalePercent"
                ],
                "properties": {
                  "rarity": {
                    "enum": [
                      "common",
                      "rare",
                      "very_rare",
                      "epic",
                      "legendary",
                      "mythic"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "scalePercent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              }
            },
            "list": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "stat",
                  "min",
                  "max",
                  "minPerLevel",
                  "maxPerLevel"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^property(\\.[a-z0-9_]+)+$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stat": {
                    "enum": [
                      "physicalPower",
                      "agilePower",
                      "magicPower",
                      "armor",
                      "magicResistance",
                      "maxHealth",
                      "maxEndurance",
                      "statusResistance"
                    ]
                  },
                  "min": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minPerLevel": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxPerLevel": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "slots": {
                    "type": "array",
                    "maxItems": 20,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "description": "Sous-lot V1.3 (version 4) : propriétés tirées au hasard sur le butin non nommé. Bornes d'une propriété au niveau N de l'objet : (min + minPerLevel × (N − 1)) et (max + maxPerLevel × (N − 1)), × l'échelle de la rareté."
        }
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "accepts": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Sorte d'objet reçue (ring pour les deux anneaux) ; absente : l'identifiant de la place."
        },
        "group": {
          "enum": [
            "combat",
            "shard",
            "tool"
          ],
          "description": "combat (défaut), shard (l'Éclat du Seuil) ou tool (outil de métier, sans bonus de combat)."
        },
        "required": {
          "type": "boolean",
          "description": "Toujours occupée, pour toutes les classes : on échange, on n'ôte pas."
        },
        "requiredBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Classes pour lesquelles la place est toujours occupée (le bouclier du Bastion)."
        },
        "guard": {
          "type": "boolean",
          "description": "La place porte la garde : ses objets ont une garde propre (le bouclier), une seule place."
        },
        "effects": {
          "type": "boolean",
          "description": "Sous-lot V1.3 (version 4) : ses objets peuvent porter des effets (armes et bijoux) ; place du combat seulement."
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "rarity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^item(\\.[a-z0-9_]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "maxLength": 64,
          "description": "Sous-lot V1.2 : icône peinte (Resources/EdsInterface/Peintes, sans extension) ; absente : la fin de l'identifiant."
        },
        "type": {
          "enum": [
            "equipment",
            "material",
            "consumable"
          ]
        },
        "rarity": {
          "enum": [
            "common",
            "rare",
            "very_rare",
            "epic",
            "legendary",
            "mythic"
          ],
          "description": "Six rangs (cadrage Q30) ; « Secret » est une origine, pas un rang."
        },
        "stack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999,
          "description": "Matériau ou objet de soin : taille d'une pile (un objet de soin en emporte au plus une pile au combat)."
        },
        "slot": {
          "type": "string",
          "description": "Équipement seulement : une sorte de place (accepts d'une place)."
        },
        "requiredLevel": {
          "type": "integer",
          "minimum": 1,
          "description": "Équipement seulement."
        },
        "bonus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "physicalPower": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "agilePower": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "magicPower": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "armor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "magicResistance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "maxHealth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "maxEndurance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            "statusResistance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            }
          }
        },
        "heal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "Objet de soin seulement (sous-lot 12.6) : PV rendus."
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000,
          "description": "Objet de soin seulement : recharge partagée qui suit son usage, en ms (multiple de 50)."
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "damageReduction",
            "costPerBlock",
            "parryWindowMs"
          ],
          "properties": {
            "damageReduction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "costPerBlock": {
              "type": "integer",
              "minimum": 0
            },
            "parryWindowMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Bouclier seulement (place qui porte la garde) : part bloquée, endurance d'un blocage, fenêtre de parade ; bornes : combat.shield des règles."
        },
        "fits": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "Équipement seulement : arbres de talents auxquels l'objet convient (adéquation au build, H5)."
        },
        "named": {
          "type": "boolean",
          "description": "Sous-lot V1.3 : objet nommé fait à la main (boss, quête, légendaire) : il ne tire aucune propriété."
        },
        "set": {
          "type": "string",
          "pattern": "^set(\\.[a-z0-9_]+)+$",
          "description": "Sous-lot V1.3 : ensemble dont l'objet est une pièce (objet nommé)."
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Texte montré au joueur (objet nommé ; relu par Damien)."
            },
            "modifiers": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object"
              },
              "description": "Modificateurs (clés admises : damageDealt, damageTaken, maxHealth, endurance.regenPerSecond, status.<id>.durationDealt ; conditions whileGuarding, targetStunned)."
            },
            "triggers": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object"
              },
              "description": "Déclencheurs d'origine equipment, même forme que ceux des classes."
            }
          },
          "description": "Sous-lot V1.3 : effets, bornés par combat.equipment des règles (EquipmentEffect.Check).",
          "required": [
            "text"
          ]
        }
      }
    },
    "lootTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "drops"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^loot(\\.[a-z0-9_]+)+$"
        },
        "drops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "count",
              "chancePercent"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "chancePercent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "bonuses"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^set(\\.[a-z0-9_]+)+$",
          "maxLength": 190
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bonuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pieces",
              "text"
            ],
            "properties": {
              "pieces": {
                "enum": [
                  2,
                  4,
                  6
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "bonus": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "physicalPower": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  },
                  "agilePower": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  },
                  "magicPower": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  },
                  "armor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  },
                  "magicResistance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  },
                  "maxHealth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  },
                  "maxEndurance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  },
                  "statusResistance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50000
                  }
                }
              },
              "effects": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "modifiers": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "object"
                    },
                    "description": "Modificateurs (clés admises : damageDealt, damageTaken, maxHealth, endurance.regenPerSecond, status.<id>.durationDealt ; conditions whileGuarding, targetStunned)."
                  },
                  "triggers": {
                    "type": "array",
                    "maxItems": 2,
                    "items": {
                      "type": "object"
                    },
                    "description": "Déclencheurs d'origine equipment, même forme que ceux des classes."
                  }
                },
                "description": "Sous-lot V1.3 : effets, bornés par combat.equipment des règles (EquipmentEffect.Check)."
              }
            }
          }
        }
      },
      "description": "Sous-lot V1.3 : ensemble de 2 à 6 pièces (les objets qui le citent), bonus à 2, 4 et 6 pièces portées."
    }
  }
}
