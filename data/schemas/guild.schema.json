{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/guild.schema.json",
  "title": "Éclats du Seuil — Guilde des aventuriers",
  "description": "Sous-lot V1.7. Documentation. La validation qui fait foi est celle du programme (GuildValidator), avec les textes, l'histoire (PNJ, quêtes des épreuves, faits), la zone de l'histoire (populations, familles), les zones reliées (portes), le catalogue des objets et les marchands : les dix rangs dans l'ordre, seuils croissants, rangs ouverts d'abord (G, F, E dans les Vallons), une épreuve par rang ouvert au-dessus de G, au moins « daily » contrats par rang ouvert. Schéma 2 (réponses de Damien du 31 octobre 2026) : rushDaily (contrats pressés tirés en plus chaque jour) et rush facultatif sur un contrat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "guild"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npc",
        "maxActive",
        "daily",
        "rushDaily",
        "ranks",
        "titles",
        "contracts",
        "gates",
        "points"
      ],
      "properties": {
        "npc": {
          "type": "string",
          "pattern": "^npc(\\.[a-z0-9_]+)+$",
          "description": "Maîtresse de guilde : lui parler (F) ouvre le tableau des contrats."
        },
        "maxActive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Contrats en cours à la fois, au plus."
        },
        "daily": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Contrats tirés chaque jour du monde pour chaque rang ouvert (Pcg32 sur la clé du jour)."
        },
        "rushDaily": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Schéma 2 : contrats pressés tirés en plus chaque jour pour chaque rang ouvert (0 : aucun)."
        },
        "ranks": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "description": "Les dix rangs, de G à SSS, dans l'ordre.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "title",
              "points",
              "open",
              "trial"
            ],
            "properties": {
              "id": {
                "enum": [
                  "g",
                  "f",
                  "e",
                  "d",
                  "c",
                  "b",
                  "a",
                  "s",
                  "ss",
                  "sss"
                ]
              },
              "name": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$",
                "description": "Nom du rang."
              },
              "title": {
                "type": "string",
                "pattern": "^title(\\.[a-z0-9_]+)+$",
                "description": "Titre gagné en atteignant ce rang."
              },
              "points": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000,
                "description": "Points de guilde qui ouvrent l'épreuve de ce rang (0 pour G)."
              },
              "open": {
                "type": "boolean",
                "description": "Rang ouvert dans le jeu actuel ; les rangs fermés viendront avec les régions suivantes."
              },
              "trial": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^quest(\\.[a-z0-9_]+)+$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Quête de l'épreuve de promotion (null pour G et les rangs fermés)."
              }
            }
          }
        },
        "titles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^title(\\.[a-z0-9_]+)+$",
                "maxLength": 200
              },
              "name": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              }
            }
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "kind",
              "name",
              "text",
              "objective",
              "money",
              "points",
              "xp"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^contract(\\.[a-z0-9_]+)+$",
                "maxLength": 200
              },
              "rank": {
                "enum": [
                  "g",
                  "f",
                  "e",
                  "d",
                  "c",
                  "b",
                  "a",
                  "s",
                  "ss",
                  "sss"
                ]
              },
              "kind": {
                "enum": [
                  "hunt",
                  "delivery",
                  "bounty"
                ],
                "description": "Chasse, livraison ou prime."
              },
              "name": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              },
              "text": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              },
              "objective": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "value"
                ],
                "description": "Objectif du moteur des quêtes (V1.6).",
                "properties": {
                  "kind": {
                    "enum": [
                      "defeat",
                      "defeatFamily",
                      "deliver"
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "npc": {
                    "type": "string",
                    "pattern": "^npc(\\.[a-z0-9_]+)+$",
                    "description": "Livraison : PNJ qui reçoit (la maîtresse par défaut)."
                  }
                }
              },
              "money": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000,
                "description": "Pièces de cuivre."
              },
              "points": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000,
                "description": "Points de guilde."
              },
              "xp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000,
                "description": "Expérience."
              },
              "rush": {
                "type": "boolean",
                "description": "Schéma 2 : contrat pressé, mieux payé, à finir avant la fin de la journée du monde où il est pris (sinon perdu, sans pénalité)."
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zone",
              "door",
              "rank"
            ],
            "description": "Porte qu'on ne passe qu'à partir de ce rang (accès à des lieux).",
            "properties": {
              "zone": {
                "type": "string",
                "pattern": "^zone\\.[a-z][a-z0-9_]*$"
              },
              "door": {
                "type": "string"
              },
              "rank": {
                "enum": [
                  "f",
                  "e",
                  "d",
                  "c",
                  "b",
                  "a",
                  "s",
                  "ss",
                  "sss"
                ]
              }
            }
          }
        },
        "points": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mainQuest",
            "sideQuest",
            "discovery",
            "rare",
            "facts"
          ],
          "description": "Points des accomplissements (seulement une fois inscrit) : quête finie selon sa catégorie, découverte, première victoire sur une créature rare, fait appris.",
          "properties": {
            "mainQuest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "sideQuest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "discovery": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "rare": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "creature",
                  "points"
                ],
                "properties": {
                  "creature": {
                    "type": "string"
                  },
                  "points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                }
              }
            },
            "facts": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "points"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "pattern": "^fact(\\.[a-z0-9_]+)+$"
                  },
                  "points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
