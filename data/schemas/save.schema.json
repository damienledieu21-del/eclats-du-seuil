{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/save.schema.json",
  "title": "Éclats du Seuil — sauvegarde du monde",
  "description": "Sous-lots 12.1 à 12.6, V1.1, V1.2, V1.6, V1.3 et V1.4 (version 11 ; la version 10 est celle du sous-lot V1.7). Documentation. La validation qui fait foi est celle du programme (SaveValidator) ; une sauvegarde de version 1 à 10 est mise à jour à la lecture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 11
    },
    "kind": {
      "const": "save"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone",
        "worldTick",
        "sessions",
        "consumed",
        "character"
      ],
      "properties": {
        "zone": {
          "type": "string",
          "pattern": "^zone\\.[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "worldTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 630720000
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 630720000
        },
        "consumed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+(/[a-z0-9_.]+)+$",
            "maxLength": 200
          },
          "description": "Événements consommés, triés, sans doublon. Sous-lot V1.1 : les points sûrs découverts y sont aussi (« zone.vallons/safe/place_du_bourg »).",
          "maxItems": 100000,
          "uniqueItems": true
        },
        "character": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "class",
                "xp",
                "talents",
                "activeSkills",
                "ultimate",
                "passiveSkills",
                "inventory",
                "equipment",
                "story",
                "professions",
                "money",
                "crafts"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "class": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.]+$",
                  "maxLength": 200
                },
                "xp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "talents": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "propertyNames": {
                    "pattern": "^[a-z0-9_.]+$",
                    "maxLength": 200
                  }
                },
                "activeSkills": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$",
                    "maxLength": 200
                  },
                  "maxItems": 64
                },
                "ultimate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9_.]+$",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "passiveSkills": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$",
                    "maxLength": 200
                  },
                  "maxItems": 64
                },
                "inventory": {
                  "type": "array",
                  "maxItems": 200,
                  "description": "Sous-lot 12.3 (version 3) : places occupées de l'inventaire, dans l'ordre. Sous-lot V1.3 (version 9) : instance d'objet, avec ses propriétés tirées (quantité 1). Sous-lot V1.4 (version 11) : qualité, signature et usure d'une instance (quantité 1).",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "item",
                      "count"
                    ],
                    "properties": {
                      "item": {
                        "type": "string",
                        "pattern": "^item(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 999
                      },
                      "properties": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "description": "Sous-lot V1.3 (version 9) : propriétés tirées d'une instance d'objet (id « property.… », valeur entière dans les bornes du catalogue).",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "value"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^property(\\.[a-z0-9_]+)+$",
                              "maxLength": 200
                            },
                            "value": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 50000
                            }
                          }
                        }
                      },
                      "quality": {
                        "enum": [
                          "superior",
                          "masterwork"
                        ],
                        "description": "Sous-lot V1.4 (version 11) : qualité de fabrication ; normale : champ absent."
                      },
                      "signedBy": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "maxLength": 64,
                        "description": "Sous-lot V1.4 (version 11) : personnage qui a signé ce chef-d'œuvre (obligatoire pour un chef-d'œuvre, interdit sinon)."
                      },
                      "wear": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000,
                        "description": "Sous-lot V1.4 (version 11) : points de solidité qui restent (sous la solidité du catalogue) ; usure pleine : champ absent."
                      }
                    }
                  }
                },
                "equipment": {
                  "type": "object",
                  "description": "Sous-lot 12.3 (version 3) : objet porté par emplacement, emplacements dans l'ordre ordinal. Version 7 (sous-lot V1.2) : les 18 places du catalogue des objets (weapon, shield, head, shoulders, cloak, chest, bracers, hands, belt, legs, feet, neck, ring_1, ring_2, relic_1, relic_2, shard, tool). Sous-lot V1.3 (version 9) : un objet aux propriétés tirées s'écrit sous sa forme d'instance { item, properties }. Sous-lot V1.4 (version 11) : de même pour une qualité de fabrication ou une usure entamée ({ item, quality, signedBy, wear }).",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^item(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "item"
                        ],
                        "properties": {
                          "item": {
                            "type": "string",
                            "pattern": "^item(\\.[a-z0-9_]+)+$",
                            "maxLength": 200
                          },
                          "properties": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 8,
                            "description": "Sous-lot V1.3 (version 9) : propriétés tirées d'une instance d'objet (id « property.… », valeur entière dans les bornes du catalogue).",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "id",
                                "value"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^property(\\.[a-z0-9_]+)+$",
                                  "maxLength": 200
                                },
                                "value": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 50000
                                }
                              }
                            }
                          },
                          "quality": {
                            "enum": [
                              "superior",
                              "masterwork"
                            ],
                            "description": "Sous-lot V1.4 (version 11) : qualité de fabrication ; normale : champ absent."
                          },
                          "signedBy": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "maxLength": 64,
                            "description": "Sous-lot V1.4 (version 11) : personnage qui a signé ce chef-d'œuvre (obligatoire pour un chef-d'œuvre, interdit sinon)."
                          },
                          "wear": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000,
                            "description": "Sous-lot V1.4 (version 11) : points de solidité qui restent (sous la solidité du catalogue) ; usure pleine : champ absent."
                          }
                        },
                        "anyOf": [
                          {
                            "required": [
                              "properties"
                            ]
                          },
                          {
                            "required": [
                              "quality"
                            ]
                          },
                          {
                            "required": [
                              "wear"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 64
                  },
                  "maxProperties": 64
                },
                "story": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "facts",
                    "quests",
                    "trust",
                    "discoveries",
                    "tracked"
                  ],
                  "description": "Sous-lot 12.5 (version 4) : état narratif personnel (faits appris, avancement des quêtes, confiance des PNJ, découvertes), trié. Sous-lot V1.6 (version 8) : quête suivie (tracked, ou null) ; étape réservée « reward » (récompense au choix en attente). Une sauvegarde de version 7 ou antérieure n'a ni l'un ni l'autre (aucune quête suivie à la lecture).",
                  "properties": {
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^fact(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      },
                      "maxItems": 10000,
                      "uniqueItems": true
                    },
                    "quests": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "step",
                          "progress"
                        ],
                        "properties": {
                          "step": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "maxLength": 64
                          },
                          "progress": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000
                          }
                        }
                      },
                      "maxProperties": 10000,
                      "propertyNames": {
                        "pattern": "^quest(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      }
                    },
                    "trust": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100,
                        "not": {
                          "const": 0
                        }
                      },
                      "maxProperties": 10000,
                      "propertyNames": {
                        "pattern": "^npc(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      }
                    },
                    "discoveries": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^discovery(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      },
                      "maxItems": 10000,
                      "uniqueItems": true
                    },
                    "tracked": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^quest(\\.[a-z0-9_]+)+$",
                          "maxLength": 200
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "professions": {
                  "type": "object",
                  "description": "Sous-lot 12.6 (version 5) : expérience non nulle de chaque métier, séparée de celle du combat.",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 64
                  },
                  "maxProperties": 64
                },
                "money": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999999999,
                  "description": "Sous-lot V1.1 (version 6) : bourse du personnage, en pièces de cuivre (100 cuivre font 1 argent, 100 argent font 1 or)."
                },
                "crafts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000,
                  "description": "Sous-lot V1.4 (version 11) : fabrications tentées par le personnage (compteur de la clé du tirage d'une fabrication) ; 0 pour une sauvegarde antérieure."
                }
              }
            }
          ],
          "description": "Personnage du joueur (version 2 ; inventaire et équipement : version 3), ou null tant qu'aucun n'a été créé."
        }
      }
    }
  }
}
