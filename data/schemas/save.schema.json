{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/save.schema.json",
  "title": "Éclats du Seuil — sauvegarde du monde",
  "description": "Sous-lots 12.1 à 12.6. Documentation. La validation qui fait foi est celle du programme (SaveValidator) ; une sauvegarde de version 1 à 4 est mise à jour à la lecture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 5
    },
    "kind": {
      "const": "save"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone",
        "worldTick",
        "sessions",
        "consumed",
        "character"
      ],
      "properties": {
        "zone": {
          "type": "string",
          "pattern": "^zone\\.[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "worldTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 630720000
        },
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 630720000
        },
        "consumed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+(/[a-z0-9_.]+)+$",
            "maxLength": 200
          },
          "description": "Événements consommés, triés, sans doublon.",
          "maxItems": 100000,
          "uniqueItems": true
        },
        "character": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "class",
                "xp",
                "talents",
                "activeSkills",
                "ultimate",
                "passiveSkills",
                "inventory",
                "equipment",
                "story",
                "professions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "class": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.]+$",
                  "maxLength": 200
                },
                "xp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "talents": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "propertyNames": {
                    "pattern": "^[a-z0-9_.]+$",
                    "maxLength": 200
                  }
                },
                "activeSkills": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$",
                    "maxLength": 200
                  },
                  "maxItems": 64
                },
                "ultimate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z0-9_.]+$",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "passiveSkills": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$",
                    "maxLength": 200
                  },
                  "maxItems": 64
                },
                "inventory": {
                  "type": "array",
                  "maxItems": 200,
                  "description": "Sous-lot 12.3 (version 3) : places occupées de l'inventaire, dans l'ordre.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "item",
                      "count"
                    ],
                    "properties": {
                      "item": {
                        "type": "string",
                        "pattern": "^item(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 999
                      }
                    }
                  }
                },
                "equipment": {
                  "type": "object",
                  "description": "Sous-lot 12.3 (version 3) : objet porté par emplacement, emplacements dans l'ordre ordinal.",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^item(\\.[a-z0-9_]+)+$",
                    "maxLength": 200
                  },
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 64
                  },
                  "maxProperties": 64
                },
                "story": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "facts",
                    "quests",
                    "trust",
                    "discoveries"
                  ],
                  "description": "Sous-lot 12.5 (version 4) : état narratif personnel (faits appris, avancement des quêtes, confiance des PNJ, découvertes), trié.",
                  "properties": {
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^fact(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      },
                      "maxItems": 10000,
                      "uniqueItems": true
                    },
                    "quests": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "step",
                          "progress"
                        ],
                        "properties": {
                          "step": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "maxLength": 64
                          },
                          "progress": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000
                          }
                        }
                      },
                      "maxProperties": 10000,
                      "propertyNames": {
                        "pattern": "^quest(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      }
                    },
                    "trust": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100,
                        "not": {
                          "const": 0
                        }
                      },
                      "maxProperties": 10000,
                      "propertyNames": {
                        "pattern": "^npc(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      }
                    },
                    "discoveries": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^discovery(\\.[a-z0-9_]+)+$",
                        "maxLength": 200
                      },
                      "maxItems": 10000,
                      "uniqueItems": true
                    }
                  }
                },
                "professions": {
                  "type": "object",
                  "description": "Sous-lot 12.6 (version 5) : expérience non nulle de chaque métier, séparée de celle du combat.",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 64
                  },
                  "maxProperties": 64
                }
              }
            }
          ],
          "description": "Personnage du joueur (version 2 ; inventaire et équipement : version 3), ou null tant qu'aucun n'a été créé."
        }
      }
    }
  }
}
