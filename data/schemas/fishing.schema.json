{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/fishing.schema.json",
  "title": "Éclats du Seuil — pêche et carnet",
  "description": "Pêche (vague 4 du plan des Vallons), version 1 : délai de la touche, fenêtre pour ferrer, distance au poste, postes de pêche (place dans l'aire, espèces) et espèces (objet du catalogue, poids du tirage, tailles en cm, saisons et moments facultatifs). Documentation. La validation qui fait foi est celle du programme (FishingValidator), avec la zone, les textes et le catalogue des objets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "fishing"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biteMinMs",
        "biteMaxMs",
        "windowMs",
        "range",
        "spots",
        "fish",
        "baits"
      ],
      "properties": {
        "biteMinMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "biteMaxMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "windowMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "range": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "spots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position",
              "fish"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "name": {
                "type": "string"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "fish": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "fish": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "weight",
              "minCm",
              "maxCm"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "minCm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "maxCm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "seasons": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "enum": [
                    "spring",
                    "summer",
                    "autumn",
                    "winter"
                  ]
                }
              },
              "phases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "enum": [
                    "dawn",
                    "day",
                    "dusk",
                    "night"
                  ]
                }
              }
            }
          }
        },
        "baits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^item\\.[a-z0-9_]+$"
          },
          "description": "Appâts acceptés (objets matériaux), pris dans le sac dans cet ordre ; chaque lancer en consomme un (décision de Damien du 15 novembre 2026)."
        }
      }
    }
  }
}
