{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/class.schema.json",
  "title": "Éclats du Seuil — définition d'une classe (arbres, talents, compétences)",
  "description": "Documentation et aide à la saisie. La validation qui fait foi est celle du programme (ClassValidator), qui vérifie aussi les références, les cycles et la faisabilité des talents majeurs avec les règles de progression de rules.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Chemin de ce schéma, ignoré par le programme."
    },
    "schemaVersion": {
      "const": 5
    },
    "kind": {
      "const": "class"
    },
    "contentVersion": {
      "type": "string",
      "description": "Version SemVer du contenu, ex. 0.1.0-provisoire."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "trees",
        "skills"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "pattern": "^class(\\.[a-z0-9_]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trees": {
          "type": "array",
          "description": "Exactement progression.treesPerClass arbres (3 en v0).",
          "items": {
            "$ref": "#/$defs/tree"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$",
      "description": "Identifiant stable, jamais renommé ni réutilisé."
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "talent",
        "rank"
      ],
      "properties": {
        "talent": {
          "$ref": "#/$defs/id",
          "pattern": "^talent(\\.[a-z0-9_]+)+$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "description": "Rang minimal exigé dans ce talent."
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "talents"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "pattern": "^tree(\\.[a-z0-9_]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "talents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/talent"
          }
        }
      }
    },
    "talent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "maxRank",
        "major",
        "placeholder",
        "prerequisites"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "pattern": "^talent(\\.[a-z0-9_]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "maxRank": {
          "type": "integer",
          "minimum": 1,
          "description": "1 point par rang ; un talent majeur a 1 rang."
        },
        "major": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "boolean",
          "description": "Talent de test sans effet, identifié « [TEST] »."
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "triggers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/trigger"
          },
          "description": "Déclencheurs (lot 7.3), au plus 8."
        },
        "modifiers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/modifier"
          },
          "description": "Modificateurs (sous-lot 8.1), au plus 8 ; valeurs par rang."
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "minLevel",
        "placeholder",
        "talentRequirements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "pattern": "^skill(\\.[a-z0-9_]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "active",
            "ultimate",
            "passive"
          ]
        },
        "minLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "placeholder": {
          "type": "boolean"
        },
        "talentRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "combat": {
          "$ref": "#/$defs/combat"
        },
        "triggers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/trigger"
          },
          "description": "Déclencheurs (lot 7.3), au plus 8."
        },
        "modifiers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/modifier"
          },
          "description": "Modificateurs (sous-lot 8.1), compétences passives seulement, au plus 8 ; sans perRank."
        }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "description": "Facultatif. Dégâts directs, coût, recharge, caractère imparable et Charges de rempart d'une compétence lançable (lots 5 et 6). Sans ce bloc, la compétence s'équipe mais ne se lance pas encore.",
      "required": [
        "powerType",
        "damageType",
        "coefficient",
        "enduranceCost",
        "cooldownMs",
        "targeting",
        "unblockable",
        "rampartChargeCost",
        "rampartChargeGain",
        "provisional",
        "applies"
      ],
      "properties": {
        "powerType": {
          "enum": [
            "physique",
            "agile",
            "magique"
          ]
        },
        "damageType": {
          "enum": [
            "physique",
            "magique"
          ]
        },
        "coefficient": {
          "type": "number",
          "minimum": 0,
          "description": "Part de la puissance, 4 décimales au plus (1.2 = 120 %)."
        },
        "enduranceCost": {
          "type": "integer",
          "minimum": 0
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Recharge démarrant au lancement, multiple de la durée du tick."
        },
        "targeting": {
          "enum": [
            "enemy",
            "allEnemies"
          ],
          "description": "enemy : la cible désignée ; allEnemies : tous les ennemis vivants, par identifiant."
        },
        "unblockable": {
          "type": "boolean",
          "description": "Imparable : ignore la garde et la parade (A1, A2)."
        },
        "rampartChargeCost": {
          "type": "integer",
          "minimum": 0,
          "description": "Charges de rempart exigées et dépensées au lancement (A4)."
        },
        "rampartChargeGain": {
          "type": "integer",
          "minimum": 0,
          "description": "Charges de rempart gagnées au lancement (A4) ; excédent perdu."
        },
        "provisional": {
          "type": "boolean",
          "description": "Valeurs provisoires, non équilibrées."
        },
        "applies": {
          "type": "array",
          "description": "Altérations appliquées à chaque cible touchée après l'impact (lot 7.2) ; éventuellement vide.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "description": "Identifiant d'une altération du bloc statuses de rules.json (ni immunité ni rupture de garde)."
              },
              "coefficient": {
                "type": "number",
                "description": "DOT seulement, obligatoire : coefficient de la puissance de la source par tick, [0, 100]."
              }
            }
          }
        }
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "add"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "Clé de la liste fermée (docs/DONNEES.md) : guard.damageReduction, guard.upkeepPerSecond, guard.costPerBlock, guard.noUpkeepBreak, guard.reductionAtZeroEndurance, guard.breakShortenPerCharge, parry.windowMs, parry.failureRecoveryMs, rampartCharges.max, resonance.perDirectHit, endurance.max, endurance.regenPerSecond, maxHealth, statusResistance, damageDealt, damageTaken, status.<id>.durationDealt, status.<id>.durationTaken, <id de compétence>.coefficient, <id de compétence>.cooldownMs.",
          "pattern": "^(guard\\.(damageReduction|upkeepPerSecond|costPerBlock|noUpkeepBreak|reductionAtZeroEndurance|breakShortenPerCharge)|parry\\.(windowMs|failureRecoveryMs)|rampartCharges\\.max|resonance\\.perDirectHit|endurance\\.(max|regenPerSecond)|maxHealth|statusResistance|damageDealt|damageTaken|status\\.[a-z][A-Za-z0-9]*\\.(durationDealt|durationTaken)|skill(\\.[a-z0-9_]+)+\\.(coefficient|cooldownMs))$"
        },
        "add": {
          "$ref": "#/$defs/rankedValue",
          "description": "Valeur ajoutée au rang 1, plus perRank par rang au-delà (talents). Drapeau guard.noUpkeepBreak : 1 exactement."
        },
        "conditions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "whileGuarding",
              "perRampartCharge",
              "perResonanceStep"
            ]
          },
          "description": "X2, damageDealt et damageTaken seulement ; au plus une condition multiplicative (perRampartCharge ou perResonanceStep)."
        }
      }
    },
    "rankedValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base": {
              "type": "number"
            },
            "perRank": {
              "type": "number",
              "description": "Talents seulement : ajouté à chaque rang au-delà du premier."
            }
          },
          "required": [
            "base"
          ]
        }
      ],
      "description": "Nombre décimal, ou valeur par rang { base, perRank } (talents seulement)."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "enum": [
            "onSkillCast",
            "onHitDealt",
            "onHitTaken",
            "onBlock",
            "onPerfectParry",
            "onGuardBroken",
            "onResourceGained",
            "onStateApplied",
            "onStateExpired",
            "onStateRemoved",
            "onDotTick",
            "onDeath"
          ],
          "description": "Type d'abonnement : l'événement de jeu observé (les diagnostics ne déclenchent jamais)."
        },
        "role": {
          "enum": [
            "self",
            "source",
            "target"
          ],
          "description": "Rôle du porteur dans l'événement ; facultatif quand le type n'en admet qu'un."
        },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Compétences ou attaques d'assaillant."
            },
            "damageType": {
              "enum": [
                "physique",
                "magique"
              ]
            },
            "defense": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "guard",
                  "parry",
                  "unblockable",
                  "guardBroken"
                ]
              }
            },
            "status": {
              "type": "string"
            },
            "category": {
              "enum": [
                "dot",
                "control",
                "modifier",
                "immunity"
              ]
            },
            "resource": {
              "enum": [
                "rampartCharges",
                "resonance"
              ]
            },
            "renewed": {
              "type": "boolean"
            }
          }
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000,
          "description": "Recharge interne : intervalle minimal entre deux réactions acceptées, multiple du tick."
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "strike",
                  "applyStatus",
                  "gainResource"
                ]
              },
              "target": {
                "enum": [
                  "eventSource",
                  "eventTarget",
                  "bearer",
                  "allEnemies"
                ]
              },
              "coefficient": {
                "$ref": "#/$defs/rankedValue"
              },
              "powerType": {
                "enum": [
                  "physique",
                  "agile",
                  "magique"
                ]
              },
              "damageType": {
                "enum": [
                  "physique",
                  "magique"
                ]
              },
              "unblockable": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "resource": {
                "enum": [
                  "rampartCharges",
                  "resonance",
                  "endurance"
                ]
              },
              "amount": {
                "$ref": "#/$defs/rankedValue"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "required": [
        "on",
        "effects"
      ],
      "description": "Déclencheur (lot 7.3) : 1 à 4 effets exécutés comme une seule réaction."
    }
  }
}
