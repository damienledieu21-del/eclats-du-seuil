{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/story.schema.json",
  "title": "Éclats du Seuil — PNJ, dialogues, quêtes",
  "description": "Sous-lot 12.5 ; sous-lot V1.1 (schéma 2) : effet giveMoney. Documentation. La validation qui fait foi est celle du programme (StoryValidator), avec les textes, la zone et le catalogue des objets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "story"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npcs",
        "dialogues",
        "quests",
        "discoveries"
      ],
      "properties": {
        "npcs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position",
              "dialogue"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^npc(\\.[a-z0-9_]+)+$"
              },
              "name": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              },
              "position": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "dialogue": {
                "type": "string"
              }
            }
          }
        },
        "dialogues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "entries",
              "nodes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^dialogue(\\.[a-z0-9_]+)+$"
              },
              "entries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "conditions",
                    "node"
                  ],
                  "properties": {
                    "conditions": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "if"
                        ],
                        "properties": {
                          "if": {
                            "enum": [
                              "fact",
                              "notFact",
                              "questNotStarted",
                              "questActive",
                              "questAt",
                              "questDone",
                              "trustAtLeast",
                              "trustBelow",
                              "hasItem",
                              "phase",
                              "inPlace",
                              "passageOpen"
                            ]
                          },
                          "id": {
                            "type": "string"
                          },
                          "value": {
                            "type": "integer"
                          },
                          "step": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "node": {
                      "type": "string"
                    }
                  }
                }
              },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text",
                    "choices"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^text(\\.[a-z0-9_]+)+$"
                    },
                    "choices": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "text",
                          "conditions",
                          "effects",
                          "next"
                        ],
                        "properties": {
                          "text": {
                            "type": "string",
                            "pattern": "^text(\\.[a-z0-9_]+)+$"
                          },
                          "conditions": {
                            "type": "array",
                            "maxItems": 8,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "if"
                              ],
                              "properties": {
                                "if": {
                                  "enum": [
                                    "fact",
                                    "notFact",
                                    "questNotStarted",
                                    "questActive",
                                    "questAt",
                                    "questDone",
                                    "trustAtLeast",
                                    "trustBelow",
                                    "hasItem",
                                    "phase",
                                    "inPlace",
                                    "passageOpen"
                                  ]
                                },
                                "id": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "integer"
                                },
                                "step": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "effects": {
                            "type": "array",
                            "maxItems": 8,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "do"
                              ],
                              "properties": {
                                "do": {
                                  "enum": [
                                    "setFact",
                                    "trust",
                                    "startQuest",
                                    "giveItem",
                                    "takeItem",
                                    "giveXp",
                                    "giveMoney",
                                    "openPassage",
                                    "discover"
                                  ]
                                },
                                "id": {
                                  "type": "string"
                                },
                                "value": {
                                  "type": "integer"
                                }
                              }
                            }
                          },
                          "next": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "quests": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "steps",
              "effects"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^quest(\\.[a-z0-9_]+)+$"
              },
              "name": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text",
                    "objective",
                    "effects"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^text(\\.[a-z0-9_]+)+$"
                    },
                    "objective": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "fact",
                            "reach",
                            "defeat",
                            "collect",
                            "passage"
                          ]
                        },
                        "id": {
                          "type": "string"
                        },
                        "value": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "effects": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "do"
                        ],
                        "properties": {
                          "do": {
                            "enum": [
                              "setFact",
                              "trust",
                              "startQuest",
                              "giveItem",
                              "takeItem",
                              "giveXp",
                              "giveMoney",
                              "openPassage",
                              "discover"
                            ]
                          },
                          "id": {
                            "type": "string"
                          },
                          "value": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "effects": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "do"
                  ],
                  "properties": {
                    "do": {
                      "enum": [
                        "setFact",
                        "trust",
                        "startQuest",
                        "giveItem",
                        "takeItem",
                        "giveXp",
                        "giveMoney",
                        "openPassage",
                        "discover"
                      ]
                    },
                    "id": {
                      "type": "string"
                    },
                    "value": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "discoveries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^discovery(\\.[a-z0-9_]+)+$"
              },
              "text": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              }
            }
          }
        }
      }
    }
  }
}
