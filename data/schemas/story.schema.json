{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/story.schema.json",
  "title": "Éclats du Seuil — PNJ, dialogues, quêtes",
  "description": "Sous-lot 12.5 ; sous-lot V1.1 (schéma 2) : effet giveMoney ; sous-lot V1.6 (schéma 3) : catégorie de quête (category), conditions d'ouverture (requires), récompenses au choix (rewardChoice), objectifs talk, deliver (npc), defeatFamily, equipped, effet takeMoney, condition levelAtLeast, zone d'un PNJ (intérieur) ; sous-lot V1.7 (schéma 4) : objectif guildRank, effet giveGuildPoints, condition guildRankAtLeast (rangs g, f, e… de la Guilde des aventuriers). Documentation. La validation qui fait foi est celle du programme (StoryValidator), avec les textes, la zone, ses intérieurs et le catalogue des objets. Sous-lot V1.9.6 (schéma 6) : objectif practice (geste de combat du joueur : strike, guard, parry, drink) et liste facultative scenes (scènes jouées dans un intérieur : zone, actor, start, end, text, back). Sous-lot V1.9.7 (schéma 7) : effet skipQuest (une quête en cours est finie sans ses effets restants ni sa récompense : « Je sais me battre » passe le tutoriel).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        4,
        5,
        6,
        7
      ]
    },
    "kind": {
      "const": "story"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npcs",
        "dialogues",
        "quests",
        "discoveries"
      ],
      "properties": {
        "npcs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position",
              "dialogue"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^npc(\\.[a-z0-9_]+)+$"
              },
              "name": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              },
              "position": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "dialogue": {
                "type": "string"
              },
              "zone": {
                "type": "string",
                "pattern": "^zone\\.[a-z][a-z0-9_]*$",
                "description": "Sous-lot V1.6 : intérieur où vit le PNJ (absent : la zone de l'histoire)."
              }
            }
          }
        },
        "dialogues": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "entries",
              "nodes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^dialogue(\\.[a-z0-9_]+)+$"
              },
              "entries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "conditions",
                    "node"
                  ],
                  "properties": {
                    "conditions": {
                      "$ref": "#/$defs/conditions"
                    },
                    "node": {
                      "type": "string"
                    }
                  }
                }
              },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text",
                    "choices"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^text(\\.[a-z0-9_]+)+$"
                    },
                    "choices": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "text",
                          "conditions",
                          "effects",
                          "next"
                        ],
                        "properties": {
                          "text": {
                            "type": "string",
                            "pattern": "^text(\\.[a-z0-9_]+)+$"
                          },
                          "conditions": {
                            "$ref": "#/$defs/conditions"
                          },
                          "effects": {
                            "$ref": "#/$defs/effects"
                          },
                          "next": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "quests": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "category",
              "steps",
              "effects"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^quest(\\.[a-z0-9_]+)+$"
              },
              "name": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text",
                    "objective",
                    "effects"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "not": {
                        "enum": [
                          "done",
                          "reward"
                        ]
                      }
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^text(\\.[a-z0-9_]+)+$"
                    },
                    "objective": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "id"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "fact",
                            "reach",
                            "defeat",
                            "collect",
                            "passage",
                            "talk",
                            "deliver",
                            "defeatFamily",
                            "equipped",
                            "guildRank",
                            "craftQuality",
                            "practice"
                          ]
                        },
                        "id": {
                          "type": "string"
                        },
                        "value": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "npc": {
                          "type": "string"
                        },
                        "quality": {
                          "enum": [
                            "superior",
                            "masterwork"
                          ],
                          "description": "Sous-lot V1.9.3b (schéma 5) : qualité minimale de l'objectif craftQuality (équipement forgé) ; seul cet objectif a une qualité."
                        }
                      }
                    },
                    "effects": {
                      "$ref": "#/$defs/effects"
                    }
                  }
                }
              },
              "effects": {
                "$ref": "#/$defs/effects"
              },
              "category": {
                "enum": [
                  "main",
                  "side"
                ]
              },
              "requires": {
                "$ref": "#/$defs/conditions"
              },
              "skippable": {
                "type": "boolean",
                "description": "Sous-lot V1.9.7 (schéma 7) : la quête peut être passée par un effet skipQuest (le tutoriel) ; faux par défaut ; jamais une épreuve de la guilde."
              },
              "rewardChoice": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "do",
                    "id",
                    "value"
                  ],
                  "properties": {
                    "do": {
                      "const": "giveItem"
                    },
                    "id": {
                      "type": "string"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "discoveries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^discovery(\\.[a-z0-9_]+)+$"
              },
              "text": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              }
            }
          }
        },
        "scenes": {
          "type": "array",
          "maxItems": 16,
          "description": "Sous-lot V1.9.6 (schéma 6) : scènes jouées (le souvenir de la Rupture).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "zone",
              "actor",
              "start",
              "end",
              "text",
              "back"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^scene(\\.[a-z0-9_]+)+$"
              },
              "zone": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "start": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$"
              },
              "end": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$"
              },
              "text": {
                "type": "string"
              },
              "back": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "if"
      ],
      "properties": {
        "if": {
          "enum": [
            "fact",
            "notFact",
            "questNotStarted",
            "questActive",
            "questAt",
            "questDone",
            "trustAtLeast",
            "trustBelow",
            "hasItem",
            "phase",
            "inPlace",
            "passageOpen",
            "levelAtLeast",
            "questReward",
            "guildRankAtLeast"
          ]
        },
        "id": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        },
        "step": {
          "type": "string"
        }
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "do"
      ],
      "properties": {
        "do": {
          "enum": [
            "setFact",
            "trust",
            "startQuest",
            "giveItem",
            "takeItem",
            "giveXp",
            "giveMoney",
            "takeMoney",
            "giveGuildPoints",
            "openPassage",
            "discover",
            "skipQuest"
          ]
        },
        "id": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/effect"
      }
    }
  }
}
