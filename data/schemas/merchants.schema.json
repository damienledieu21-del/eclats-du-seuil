{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/merchants.schema.json",
  "title": "Éclats du Seuil — marchands et valeur des objets",
  "description": "Sous-lot V1.1. Documentation. La validation qui fait foi est celle du programme (MerchantValidator), avec les textes, l'histoire (PNJ) et le catalogue des objets : aucun objet vendu sous sa valeur de base, offres tirées chaque jour qui laissent toujours quelque chose en vente.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        2,
        3,
        4,
        5,
        6
      ]
    },
    "kind": {
      "const": "merchants"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "merchants"
      ],
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 1024,
          "description": "Valeur de base de chaque objet qui se vend ou s'achète, en pièces de cuivre (100 cuivre font 1 argent, 100 argent font 1 or). Un objet sans valeur ne se vend pas (objet de quête).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "value"
            ],
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^item(\\.[a-z0-9_]+)+$",
                "maxLength": 200
              },
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              }
            }
          }
        },
        "merchants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "npc",
              "greeting",
              "sellPercent",
              "closed",
              "daily",
              "offers"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^merchant(\\.[a-z0-9_]+)+$",
                "maxLength": 200
              },
              "npc": {
                "type": "string",
                "pattern": "^npc(\\.[a-z0-9_]+)+$",
                "description": "PNJ de l'histoire qui tient la boutique : lui parler (F) l'ouvre."
              },
              "greeting": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$",
                "description": "Clé du texte d'accueil de la boutique."
              },
              "sellPercent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Part de la valeur de base payée au joueur qui vend (pour cent, arrondie au cuivre inférieur, au moins 1 cuivre)."
              },
              "closed": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "dawn",
                    "day",
                    "dusk",
                    "night"
                  ]
                },
                "description": "Moments de la journée où la boutique est fermée."
              },
              "rank": {
                "enum": [
                  "g",
                  "f",
                  "e",
                  "d",
                  "c",
                  "b",
                  "a",
                  "s",
                  "ss",
                  "sss"
                ],
                "description": "Sous-lot V1.7 (schéma 2) : rang de la Guilde des aventuriers demandé pour ouvrir la boutique (la boutique de la guilde) ; facultatif."
              },
              "faction": {
                "enum": [
                  "villagers",
                  "guard",
                  "rangers",
                  "bandits"
                ],
                "description": "Sous-lot V2.7 (schéma 4) : faction dont la réputation règle les prix et l'accueil (absente : villagers)."
              },
              "standing": {
                "enum": [
                  "hated",
                  "hostile",
                  "wary",
                  "neutral",
                  "liked",
                  "honored",
                  "hero"
                ],
                "description": "Sous-lot V2.7 (schéma 4) : palier de la faction demandé pour ouvrir la boutique (le marché noir des bandits) ; facultatif."
              },
              "fact": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$",
                "maxLength": 200,
                "description": "Sous-lot V1.9.3b (schéma 3) : fait de l'histoire demandé pour ouvrir la boutique (posé par un setFact de l'histoire) ; facultatif."
              },
              "daily": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32,
                "description": "Offres non permanentes tirées chaque jour du monde (tirage déterministe sur la clé du jour)."
              },
              "offers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "item",
                    "price",
                    "always"
                  ],
                  "properties": {
                    "item": {
                      "type": "string",
                      "pattern": "^item(\\.[a-z0-9_]+)+$",
                      "maxLength": 200
                    },
                    "rank": {
                      "enum": [
                        "g",
                        "f",
                        "e",
                        "d",
                        "c",
                        "b",
                        "a",
                        "s",
                        "ss",
                        "sss"
                      ],
                      "description": "Sous-lot V1.7 (schéma 2) : rang de la guilde demandé pour acheter cette offre ; facultatif."
                    },
                    "price": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000000,
                      "description": "Prix d'une unité en cuivre, au moins la valeur de base de l'objet."
                    },
                    "always": {
                      "type": "boolean",
                      "description": "Toujours en vente ; sinon, tirée certains jours."
                    },
                    "stock": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 999,
                      "description": "Sous-lot V2.10 (schéma 5) : unités au stock plein (le stock s'épuise à l'achat et se regagne chaque jour) ; facultatif (sans limite)."
                    },
                    "fresh": {
                      "type": "boolean",
                      "description": "Sous-lot V2.14 (schéma 6) : offre fraîche qui suit les fournées (stock demandé)."
                    },
                    "door": {
                      "type": "boolean",
                      "description": "Sous-lot V2.14 (schéma 6) : vendue aussi à la porte quand la boutique est fermée (obligatoire pour un objet utile à l'histoire)."
                    }
                  }
                }
              },
              "restock": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Sous-lot V2.10 (schéma 5) : part du stock plein regagnée chaque jour du monde (pour cent, arrondie au-dessus, au moins 1 unité) ; facultative (50)."
              },
              "resale": {
                "type": "integer",
                "minimum": 100,
                "maximum": 300,
                "description": "Sous-lot V2.10 (schéma 5) : prix d'un objet revendu par le joueur qu'il ne vend pas d'ordinaire, en pour cent de sa valeur ; facultatif (125)."
              },
              "festivals": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^festival(\\.[a-z0-9_]+)+$"
                },
                "description": "Sous-lot V2.10 (schéma 5) : étal ambulant, ouvert seulement pendant ces fêtes de l'histoire ; facultatif."
              },
              "shop": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "sign",
                  "open",
                  "close"
                ],
                "description": "Sous-lot V2.14 (schéma 6) : vraie boutique dans une vraie maison : genre, enseigne, bâtiment du bourg, horaires (une fermeture avant l'ouverture passe minuit), jours de repos (0 : lundi … 6 : dimanche), qui répond à la porte quand elle est fermée.",
                "properties": {
                  "kind": {
                    "enum": [
                      "bakery",
                      "forge",
                      "inn",
                      "tailor",
                      "herbalist",
                      "grocer",
                      "armorer",
                      "guild",
                      "stall"
                    ]
                  },
                  "sign": {
                    "type": "string",
                    "pattern": "^text(\\.[a-z0-9_]+)+$"
                  },
                  "building": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 64
                  },
                  "open": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "rest": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    }
                  },
                  "door": {
                    "enum": [
                      "patron",
                      "clerk"
                    ]
                  },
                  "clerk": {
                    "type": "string",
                    "pattern": "^text(\\.[a-z0-9_]+)+$"
                  }
                }
              },
              "bakes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "description": "Sous-lot V2.14 (schéma 6) : fournées du jour (heures croissantes, parts qui font 100 %). Les offres « fresh » suivent : rien avant la première, ce que les villageois achètent jusqu'à la rupture du soir (soldOut).",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "at",
                    "percent"
                  ],
                  "properties": {
                    "at": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "percent": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  }
                }
              },
              "soldOut": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Sous-lot V2.14 (schéma 6) : rupture du soir des offres fraîches, après la dernière fournée."
              }
            }
          }
        },
        "prices": {
          "type": "array",
          "maxItems": 32,
          "description": "Sous-lot V2.10 (schéma 5) : prix qui bougent avec la saison et le temps (pour cent du prix, jamais sous la valeur de base).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "percent"
            ],
            "properties": {
              "season": {
                "enum": [
                  "spring",
                  "summer",
                  "autumn",
                  "winter"
                ]
              },
              "weather": {
                "enum": [
                  "clear",
                  "cloudy",
                  "mist",
                  "drizzle",
                  "shower",
                  "storm",
                  "rain"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^item(\\.[a-z0-9_]+)+$"
                }
              },
              "merchants": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^merchant(\\.[a-z0-9_]+)+$"
                }
              },
              "percent": {
                "type": "integer",
                "minimum": 50,
                "maximum": 300
              },
              "market": {
                "type": "boolean",
                "description": "Sous-lot V2.14 (schéma 6) : la règle ne vaut que pendant le grand jour de marché."
              }
            }
          }
        },
        "shocks": {
          "type": "array",
          "maxItems": 32,
          "description": "Sous-lot V2.10 (schéma 5) : contrecoups des événements du monde (stock plein et prix des objets touchés), le temps d'un événement réglé, ou tant qu'un fait est connu (fact) ou pas encore appris (notFact).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "stockPercent",
              "pricePercent"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "event": {
                "type": "string",
                "pattern": "^zone(\\.[a-z0-9_]+)+/[a-z0-9_]+$"
              },
              "outcome": {
                "enum": [
                  "won",
                  "lost",
                  "any"
                ]
              },
              "days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 28
              },
              "fact": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$"
              },
              "notFact": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^item(\\.[a-z0-9_]+)+$"
                }
              },
              "merchants": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^merchant(\\.[a-z0-9_]+)+$"
                }
              },
              "stockPercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "pricePercent": {
                "type": "integer",
                "minimum": 50,
                "maximum": 300
              }
            }
          }
        },
        "market": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "festivals",
            "setup",
            "teardown",
            "stalls"
          ],
          "description": "Sous-lot V2.14 (schéma 6) : grand jour de marché sur la place du bourg, les jours de fêtes hebdomadaires de l'histoire (1 ou 2 par semaine) : installation, marché (la fête), démontage.",
          "properties": {
            "festivals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^festival(\\.[a-z0-9_]+)+$"
              }
            },
            "setup": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "teardown": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "crowd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "cries": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$"
              }
            },
            "stalls": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "position"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^stall(\\.[a-z0-9_]+)+$",
                    "maxLength": 64
                  },
                  "merchant": {
                    "type": "string",
                    "pattern": "^merchant(\\.[a-z0-9_]+)+$"
                  },
                  "kind": {
                    "enum": [
                      "produce",
                      "cheese",
                      "cloth",
                      "spices",
                      "pottery",
                      "fish",
                      "meat",
                      "flowers",
                      "toys",
                      "exotic",
                      "honey",
                      "wine",
                      "bread",
                      "tools"
                    ]
                  },
                  "position": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "sign": {
                    "type": "string",
                    "pattern": "^text(\\.[a-z0-9_]+)+$"
                  }
                }
              }
            },
            "haggle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "standing",
                "percent",
                "chance"
              ],
              "properties": {
                "standing": {
                  "enum": [
                    "hated",
                    "hostile",
                    "wary",
                    "neutral",
                    "liked",
                    "honored",
                    "hero"
                  ]
                },
                "percent": {
                  "type": "integer",
                  "minimum": 50,
                  "maximum": 99
                },
                "chance": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "bonus": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    }
  }
}
