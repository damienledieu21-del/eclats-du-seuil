{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclats-du-seuil/schemas/merchants.schema.json",
  "title": "Éclats du Seuil — marchands et valeur des objets",
  "description": "Sous-lot V1.1. Documentation. La validation qui fait foi est celle du programme (MerchantValidator), avec les textes, l'histoire (PNJ) et le catalogue des objets : aucun objet vendu sous sa valeur de base, offres tirées chaque jour qui laissent toujours quelque chose en vente.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "contentVersion",
    "data"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": [
        2,
        3,
        4,
        5
      ]
    },
    "kind": {
      "const": "merchants"
    },
    "contentVersion": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "merchants"
      ],
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 1024,
          "description": "Valeur de base de chaque objet qui se vend ou s'achète, en pièces de cuivre (100 cuivre font 1 argent, 100 argent font 1 or). Un objet sans valeur ne se vend pas (objet de quête).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "value"
            ],
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^item(\\.[a-z0-9_]+)+$",
                "maxLength": 200
              },
              "value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              }
            }
          }
        },
        "merchants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "npc",
              "greeting",
              "sellPercent",
              "closed",
              "daily",
              "offers"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^merchant(\\.[a-z0-9_]+)+$",
                "maxLength": 200
              },
              "npc": {
                "type": "string",
                "pattern": "^npc(\\.[a-z0-9_]+)+$",
                "description": "PNJ de l'histoire qui tient la boutique : lui parler (F) l'ouvre."
              },
              "greeting": {
                "type": "string",
                "pattern": "^text(\\.[a-z0-9_]+)+$",
                "description": "Clé du texte d'accueil de la boutique."
              },
              "sellPercent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Part de la valeur de base payée au joueur qui vend (pour cent, arrondie au cuivre inférieur, au moins 1 cuivre)."
              },
              "closed": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "dawn",
                    "day",
                    "dusk",
                    "night"
                  ]
                },
                "description": "Moments de la journée où la boutique est fermée."
              },
              "rank": {
                "enum": [
                  "g",
                  "f",
                  "e",
                  "d",
                  "c",
                  "b",
                  "a",
                  "s",
                  "ss",
                  "sss"
                ],
                "description": "Sous-lot V1.7 (schéma 2) : rang de la Guilde des aventuriers demandé pour ouvrir la boutique (la boutique de la guilde) ; facultatif."
              },
              "faction": {
                "enum": [
                  "villagers",
                  "guard",
                  "rangers",
                  "bandits"
                ],
                "description": "Sous-lot V2.7 (schéma 4) : faction dont la réputation règle les prix et l'accueil (absente : villagers)."
              },
              "standing": {
                "enum": [
                  "hated",
                  "hostile",
                  "wary",
                  "neutral",
                  "liked",
                  "honored",
                  "hero"
                ],
                "description": "Sous-lot V2.7 (schéma 4) : palier de la faction demandé pour ouvrir la boutique (le marché noir des bandits) ; facultatif."
              },
              "fact": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$",
                "maxLength": 200,
                "description": "Sous-lot V1.9.3b (schéma 3) : fait de l'histoire demandé pour ouvrir la boutique (posé par un setFact de l'histoire) ; facultatif."
              },
              "daily": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32,
                "description": "Offres non permanentes tirées chaque jour du monde (tirage déterministe sur la clé du jour)."
              },
              "offers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "item",
                    "price",
                    "always"
                  ],
                  "properties": {
                    "item": {
                      "type": "string",
                      "pattern": "^item(\\.[a-z0-9_]+)+$",
                      "maxLength": 200
                    },
                    "rank": {
                      "enum": [
                        "g",
                        "f",
                        "e",
                        "d",
                        "c",
                        "b",
                        "a",
                        "s",
                        "ss",
                        "sss"
                      ],
                      "description": "Sous-lot V1.7 (schéma 2) : rang de la guilde demandé pour acheter cette offre ; facultatif."
                    },
                    "price": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000000,
                      "description": "Prix d'une unité en cuivre, au moins la valeur de base de l'objet."
                    },
                    "always": {
                      "type": "boolean",
                      "description": "Toujours en vente ; sinon, tirée certains jours."
                    },
                    "stock": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 999,
                      "description": "Sous-lot V2.10 (schéma 5) : unités au stock plein (le stock s'épuise à l'achat et se regagne chaque jour) ; facultatif (sans limite)."
                    }
                  }
                }
              },
              "restock": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Sous-lot V2.10 (schéma 5) : part du stock plein regagnée chaque jour du monde (pour cent, arrondie au-dessus, au moins 1 unité) ; facultative (50)."
              },
              "resale": {
                "type": "integer",
                "minimum": 100,
                "maximum": 300,
                "description": "Sous-lot V2.10 (schéma 5) : prix d'un objet revendu par le joueur qu'il ne vend pas d'ordinaire, en pour cent de sa valeur ; facultatif (125)."
              },
              "festivals": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^festival(\\.[a-z0-9_]+)+$"
                },
                "description": "Sous-lot V2.10 (schéma 5) : étal ambulant, ouvert seulement pendant ces fêtes de l'histoire ; facultatif."
              }
            }
          }
        },
        "prices": {
          "type": "array",
          "maxItems": 32,
          "description": "Sous-lot V2.10 (schéma 5) : prix qui bougent avec la saison et le temps (pour cent du prix, jamais sous la valeur de base).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "percent"
            ],
            "properties": {
              "season": {
                "enum": [
                  "spring",
                  "summer",
                  "autumn",
                  "winter"
                ]
              },
              "weather": {
                "enum": [
                  "clear",
                  "cloudy",
                  "mist",
                  "drizzle",
                  "shower",
                  "storm",
                  "rain"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^item(\\.[a-z0-9_]+)+$"
                }
              },
              "merchants": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^merchant(\\.[a-z0-9_]+)+$"
                }
              },
              "percent": {
                "type": "integer",
                "minimum": 50,
                "maximum": 300
              }
            }
          }
        },
        "shocks": {
          "type": "array",
          "maxItems": 32,
          "description": "Sous-lot V2.10 (schéma 5) : contrecoups des événements du monde (stock plein et prix des objets touchés), le temps d'un événement réglé, ou tant qu'un fait est connu (fact) ou pas encore appris (notFact).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "stockPercent",
              "pricePercent"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "event": {
                "type": "string",
                "pattern": "^zone(\\.[a-z0-9_]+)+/[a-z0-9_]+$"
              },
              "outcome": {
                "enum": [
                  "won",
                  "lost",
                  "any"
                ]
              },
              "days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 28
              },
              "fact": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$"
              },
              "notFact": {
                "type": "string",
                "pattern": "^fact(\\.[a-z0-9_]+)+$"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^item(\\.[a-z0-9_]+)+$"
                }
              },
              "merchants": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^merchant(\\.[a-z0-9_]+)+$"
                }
              },
              "stockPercent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "pricePercent": {
                "type": "integer",
                "minimum": 50,
                "maximum": 300
              }
            }
          }
        }
      }
    }
  }
}
